# ---------------------------------------------------------------------------
# Lilixy Wallet environment
# Copy to .env.local. Never commit .env.local.
# ---------------------------------------------------------------------------

# Public app version shown in Settings.
NEXT_PUBLIC_APP_VERSION=0.1.0

# LI.FI widget / SDK
# 0.0025 = 0.25% integrator fee. Must be <= 0.05.
NEXT_PUBLIC_LIFI_FEE=0.0025
# Optional public LI.FI API key (it is bundled into the client by definition).
NEXT_PUBLIC_LIFI_API_KEY=
# Optional server-side LI.FI API key used by the chains/status/RPC proxies.
LIFI_API_KEY=

# CoinGecko (server-side only)
# Demo key: https://www.coingecko.com/en/api
COINGECKO_API_KEY=
# "demo" or "pro"
COINGECKO_API_PLAN=demo

# Ranked RPC endpoints. Leave blank to use the bundled public fallback list.
NEXT_PUBLIC_RPC_ETHEREUM=
NEXT_PUBLIC_RPC_BSC=
NEXT_PUBLIC_RPC_POLYGON=
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_OPTIMISM=
NEXT_PUBLIC_RPC_BASE=
NEXT_PUBLIC_RPC_AVALANCHE=
